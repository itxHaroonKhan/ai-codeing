
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information stored in Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["Admin", "Doctor", "Receptionist", "Patient"] },
        "specialty": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "on-leave", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Patient": {
      "title": "Patient Record",
      "description": "Comprehensive medical record for a patient.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "contact": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Clinic visit scheduling record.",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "notes": { "type": "string" }
      },
      "required": ["patientId", "date", "time", "status"]
    },
    "Prescription": {
      "title": "Prescription",
      "description": "Medical prescription issued by a doctor.",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "appointmentId": { "type": "string" },
        "medicines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "dosage": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        },
        "instructions": { "type": "string" },
        "aiExplanation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "doctorId", "medicines"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and roles."
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Medical records database."
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Scheduling records."
    },
    "/prescriptions/{prescriptionId}": {
      "schema": "Prescription",
      "description": "Pharmacy records."
    }
  }
}
